# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production & Build outputs
/dist/
/build/
/.next/
/.vinext/
/out/
/.wrangler/
/.vercel/
/.cache/
*.tsbuildinfo
.eslintcache

# Reference & Archive materials
/references/
*.mhtml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev.*.log
/start.*.log

# Environment variables & secrets
.env
.env.*
!.env.example

# Databases & SQLite
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Tooling & Assistant cache
/.openai/
/.gemini/
/.claude/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.settings/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# Testing & Coverage
/coverage/
/.nyc_output/

# Temporary & Work directories
/outputs/
/work/
